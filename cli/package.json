{
  "name": "@asyncarijit/pushdeck-cli",
  "version": "0.2.2",
  "description": "CLI for the rn-pushdeck OTA service — ship JS updates to React Native apps.",
  "type": "module",
  "license": "MIT",
  "author": "asyncarijit",
  "homepage": "https://github.com/asyncArijit/RN-Pushdeck#readme",
  "keywords": [
    "react-native",
    "ota",
    "codepush",
    "cli",
    "deploy"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "pushdeck": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asyncArijit/RN-Pushdeck.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/asyncArijit/RN-Pushdeck/issues"
  }
}
